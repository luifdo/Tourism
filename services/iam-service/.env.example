# Variables de entorno de iam-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8001
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://turismo:cambiar-en-local@postgres:5432/iam_db
VALKEY_URL=redis://valkey:6379/0

RABBITMQ_URL=amqp://turismo:turismo@rabbitmq:5672/
EVENTS_EXCHANGE=turismo.eventos

S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documentos-verificacion

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
