# Variables de entorno de iam-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8001
ENVIRONMENT=development

# Valores para correr uvicorn en local contra los contenedores de docker-compose.dev.yml.
# Dentro de Docker/k8s los hosts son postgres, valkey, rabbitmq y seaweedfs, y Postgres usa el puerto 5432.
DATABASE_URL=postgresql+asyncpg://iam_user:iam_password@localhost:5433/iam_db
VALKEY_URL=redis://localhost:6379/0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=turismo.eventos

S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=documentos-verificacion

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_TTL_MINUTES=15
