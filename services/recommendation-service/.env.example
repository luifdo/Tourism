# Variables de entorno de recommendation-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8005
RABBITMQ_URL=amqp://turismo:turismo@rabbitmq:5672/
EVENTS_EXCHANGE=turismo.eventos
# Modelo de Gemini; en k3s viene de un ConfigMap
GEMINI_MODEL=
# Clave de la API de Gemini; en k3s viene de un Secret (nunca subir el valor real)
GEMINI_API_KEY=
