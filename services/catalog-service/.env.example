# Variables de entorno de catalog-service (copiar a .env; nunca subir .env al repositorio)
SERVICE_PORT=8002
ENVIRONMENT=development

# Valores para correr uvicorn en local contra los contenedores de docker-compose.dev.yml.
# Usan puertos distintos a los de iam-service para poder levantar ambos a la vez.
# Dentro de Docker/k8s los hosts son postgres, valkey y rabbitmq, con sus puertos estándar.
DATABASE_URL=postgresql+asyncpg://catalog_user:catalog_password@localhost:5434/catalog_db
VALKEY_URL=redis://localhost:6380/0

RABBITMQ_URL=amqp://guest:guest@localhost:5673/
EVENTS_EXCHANGE=turismo.eventos
